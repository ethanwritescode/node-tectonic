{
  "name": "node-tectonic",
  "version": "1.1.0",
  "description": "Tectonic LaTeX engine for Node.js. Compiles .tex to PDF with no system TeX installation.",
  "keywords": [
    "tectonic",
    "latex",
    "tex",
    "xetex",
    "pdf",
    "typesetting"
  ],
  "license": "MIT",
  "author": "Ethan James <etjames2023@gmail.com> (https://github.com/ethanwritescode)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethanwritescode/node-tectonic.git"
  },
  "bugs": {
    "url": "https://github.com/ethanwritescode/node-tectonic/issues"
  },
  "homepage": "https://github.com/ethanwritescode/node-tectonic#readme",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "tectonic": "bin/tectonic.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "bin/tectonic.js",
    "lib/"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "fetch": "node scripts/fetch-binaries.js",
    "fetch:current": "node scripts/fetch-binaries.js --current",
    "test": "node test/unit.js",
    "test:integration": "node test/basic.js"
  },
  "optionalDependencies": {
    "node-tectonic-darwin-arm64": "1.1.0",
    "node-tectonic-darwin-x64": "1.1.0",
    "node-tectonic-linux-x64": "1.1.0",
    "node-tectonic-linux-arm64": "1.1.0",
    "node-tectonic-windows-x64": "1.1.0"
  }
}
